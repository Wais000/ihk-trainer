# Your app's URL (used to build email confirmation / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from your project's Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Word-level hover translation (the only live translation call in the app;
# everything else — question text, answer options, explanations, vocabulary —
# is pre-generated offline, see scripts/prompts/*.md, and only ever read from
# the database). Gemini is tried first (prompted for the word's real concept,
# not a literal machine-translation gloss); Azure is the fallback when
# Gemini's free-tier daily quota runs out.

# Google Gemini (get a free key at aistudio.google.com/apikey).
GOOGLE_GENERATIVE_AI_API_KEY=

# Azure AI Translator — fallback only. Free tier (F0): 2M characters/month.
# Get a key at portal.azure.com — create a "Translator" resource, then Keys
# and Endpoint.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
