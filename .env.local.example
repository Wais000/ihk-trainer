# Your app's URL (used to build email confirmation / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from your project's Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI provider for enrichment (writes the German explanation + vocabulary;
# the other languages are then machine-translated via Azure below) — used
# server-side only, via /lib/ai — never called from the browser.
# Free tier, no credit card: get a key at aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Azure AI Translator (used server-side only, for word-level hover translation).
# Free tier (F0): 2M characters/month. Get a key at portal.azure.com — create a
# "Translator" resource, then Keys and Endpoint.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
